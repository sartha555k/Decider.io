# Server-only configuration. Do not commit real credentials.
TRACKER_DATABASE_PATH=./data/tracker.sqlite
# Practice mode needs no API key and makes no API calls.
# Add a key securely only when enabling live mode:
# TRACKER_OPENAI_KEY=
# Existing server-side OPENAI_API_KEY is also supported.
# Optional canonical origin for a reverse-proxied hosted installation:
# TRACKER_APP_ORIGIN=https://your-selected-host.example

# Standard Decisions pricing documented on 10 October 2026.
# Review actual regional/processing-tier prices before live use.
TRACKER_DECISION_INPUT_USD_PER_MILLION=0.10
TRACKER_DAILY_BUDGET_USD=0.05
TRACKER_MONTHLY_BUDGET_USD=1
TRACKER_DAILY_LIVE_EVALUATIONS=2
# Set either dollar budget to 0 to block all uncached live evaluations.

# Required for production; never put these in browser-visible variables.
# Username: letters/numbers/dot/underscore/hyphen only. Password: at least 16 characters.
# TRACKER_AUTH_USERNAME=operator
# TRACKER_AUTH_PASSWORD=
# Development remains open only when both access settings are unset.
